# =============================================================================
# PLANTILLA — NO es obligatorio tener archivo .env
# =============================================================================
# En LOCAL puedes exportar estas variables en PowerShell/bash O usar
# src/main/resources/application.properties (valores por defecto).
#
# En RENDER no subas .env: en el panel Web Service → Environment
# agrega las mismas variables (Render las inyecta como en un .env).
# =============================================================================

PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/inventario_backenddatabase
DB_USER=postgres
DB_PASSWORD=CAMBIAR_PASSWORD

JWT_SECRET=CAMBIAR_CLAVE_JWT_MINIMO_32_CARACTERES
JWT_EXPIRATION_MS=86400000

JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
